.gradle
**/build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# --- Additions for this project ---

# Test/run instance (world saves, logs, configs)
run/

# IDE files
.idea/
*.iml
.vscode/
out/

# Third-party jars used only to compile against Vinery - never redistribute these,
# their resources are licensed "All Rights Reserved" and are not ours to publish.
libs/*.jar

# OS junk
.DS_Store
Thumbs.db
